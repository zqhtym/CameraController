# 默认由 Git 自动处理换行符
* text=auto

# 在 Linux / WSL / 树莓派中执行的文件必须保持 LF，否则 bash 报 $'\r' 错误
*.sh              text eol=lf
windows/linux/*   text eol=lf
android/gradlew   text eol=lf

# Windows 批处理保持 CRLF
*.bat             text eol=crlf
*.cmd             text eol=crlf

# 二进制文件
*.exe             binary
*.apk             binary
*.jar             binary
*.png             binary
*.jpg             binary
